#include "/Engine/Private/Common.ush"
#include "/Engine/Private/ScreenPass.ush"

float3 ComputeStaticVelocity(float2 ScreenPos, float DeviceZ)
{
    float3 PosN = float3(ScreenPos, DeviceZ);

    float4 ThisClip = float4(PosN, 1);
    float4 PrevClip = mul(ThisClip, View.ClipToPrevClip);
    float3 PrevScreen = PrevClip.xyz / PrevClip.w;
    return PosN - PrevScreen;
}



// =====================================================================================
//
// SHADER RESOURCES
//
// =====================================================================================

// When set, the pass also copies the input colour and depth of the current view into
// textures whose origin is (0,0). Used for stereo side-by-side rendering, where the second
// eye's view rect does not start at the texture origin.
#ifndef ARMASR_COPY_INPUTS
#define ARMASR_COPY_INPUTS 0
#endif

// Where object/camera motion comes from:
//  0: UE scene velocity (encoded, written by the velocity pass).
//  1: AppSpaceWarp motion vectors (Meta fork): raw float3 NDC motion of all geometry, rendered at the
//     OpenXR recommended motion vector size, so sampled with a UV rather than a pixel position.
//  2: Depth only: camera motion reconstructed from depth. Used when the project compiles the SpaceWarp
//     velocity shaders (SUPPORT_VR_FRAME_EXTRAPOLATION) but SpaceWarp is not running this frame: the
//     velocity pass then writes raw signed values into the UNORM scene velocity, which is unusable.
//  3: Raw scene velocity: same SpaceWarp velocity shaders, but the engine patch makes the scene velocity a
//     float target, so the raw NDC motion of moving objects is kept and read as is.
#ifndef ARMASR_VELOCITY_SOURCE
#define ARMASR_VELOCITY_SOURCE 0
#endif

Texture2D InputDepth;
#if ARMASR_VELOCITY_SOURCE == 0 || ARMASR_VELOCITY_SOURCE == 3
Texture2D InputVelocity;
#elif ARMASR_VELOCITY_SOURCE == 1
Texture2D InputMotionVector;
SamplerState InputMotionVectorSampler;
#endif
#if ARMASR_COPY_INPUTS
Texture2D InputColor;
#endif

// Pixel offset of the view inside the input textures. Zero for mono and multiview
// (each eye lives in its own array slice), ViewRect.Min for side-by-side stereo.
int2 InputOffset;

void main(
    float4 SvPosition : SV_POSITION,
    out float2 OutVelocity : SV_Target0
#if ARMASR_COPY_INPUTS
    , out float4 OutColor : SV_Target1
    , out float OutDepth : SV_Target2
#endif
    )
{
    uint2 Pos = uint2(SvPosition.xy);
    int2 InputPos = int2(Pos) + InputOffset;
    float Depth = InputDepth[InputPos].x;

    // This doesn't need the viewport origin as it is a UV, not a pixel coordinate (i.e. it is relative to the origin not (0,0))
    float2 ViewportUV = (Pos + 0.5) * View.ViewSizeAndInvSize.zw;

    float2 Velocity = 0;
    bool bHasVelocity = false;
#if ARMASR_VELOCITY_SOURCE == 0
    float4 EncodedVelocity = InputVelocity[InputPos];
    if (EncodedVelocity.x > 0.0)
    {
        Velocity = DecodeVelocityFromTexture(EncodedVelocity).xy;
        bHasVelocity = true;
    }
#elif ARMASR_VELOCITY_SOURCE == 1
    // The motion vector texture covers the whole eye view. Cleared to 0 where no geometry was drawn (sky).
    float3 MotionVector = InputMotionVector.SampleLevel(InputMotionVectorSampler, ViewportUV, 0).xyz;
    if (any(MotionVector != 0.0))
    {
        Velocity = MotionVector.xy;
        bHasVelocity = true;
    }
#elif ARMASR_VELOCITY_SOURCE == 3
    // Cleared to 0, written only for moving objects when SpaceWarp is off.
    float2 RawVelocity = InputVelocity[InputPos].xy;
    if (any(RawVelocity != 0.0))
    {
        Velocity = RawVelocity;
        bHasVelocity = true;
    }
#endif

    if (!bHasVelocity)
    {
        float2 ScreenPos = ViewportUVToScreenPos(ViewportUV);
        Velocity = ComputeStaticVelocity(ScreenPos, Depth).xy;
    }

    // FSR2 expects negative velocity from what UE4 produces.  FSR2 also wants the absolute result multiplied by (0.5, -0.5).  Combine these steps by multiplying by (-0.5, 0.5).
    OutVelocity = Velocity * float2(-0.5, 0.5);

#if ARMASR_COPY_INPUTS
    OutColor = InputColor[InputPos];
    OutDepth = Depth;
#endif
}
